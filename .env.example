# Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID=

# Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_CURSO_CHAT_ID=
TELEGRAM_VIP_CHAT_ID=
# Chat privado del cliente (id numérico de usuario). Sin esto, /pagados,
# /pendientes, /resumen, /marcar_clase y los avisos de pago quedan deshabilitados.
TELEGRAM_CLIENT_CHAT_ID=

# Supabase (Postgres). Usar la service-role key: estas tablas solo se acceden server-side.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Público (expuesto al navegador — no incluir nada sensible aquí)
# Debe ser la URL final, la que NO redirige (ej. con `www` si el dominio
# redirige hacia él): Telegram no sigue redirecciones en el webhook.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_TELEGRAM_BOT_USERNAME=
NEXT_PUBLIC_TELEGRAM_CURSO_JOIN_LINK=
NEXT_PUBLIC_TELEGRAM_VIP_JOIN_LINK=
# URL pública del video del hero (Supabase Storage, Cloudinary, etc.)
NEXT_PUBLIC_HERO_VIDEO_URL=
